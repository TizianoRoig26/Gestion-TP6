# Food Store - Environment Variables
# Copiar a .env y completar con valores reales

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
# Formato: postgresql://user:password@localhost:5432/foodstore
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodstore

# ===========================================
# SECURITY
# ===========================================
# Secret key for JWT signing (mínimo 32 caracteres)
SECRET_KEY=your-super-secret-key-here-min-32-chars

# JWT Algorithm
ALGORITHM=HS256

# Token expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===========================================
# MERCADOPAGO
# ===========================================
# MercadoPago Access Token (obtener de https://www.mercadopago.com.ar/developers/panel/credentials)
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# MercadoPago Public Key (para el frontend)
MP_PUBLIC_KEY=TEST-TU-PUBLIC-KEY

# Webhook URL (para notificaciones IPN)
# En desarrollo: usar tunneling (ngrok) para recibir webhooks localmente
MP_NOTIFICATION_URL=http://localhost:8000/api/v1/pagos/webhook

# ===========================================
# ADMIN
# ===========================================
# Credenciales del usuario administrador inicial
# CAMBIAR en producción!
ADMIN_EMAIL=admin@foodstore.com
ADMIN_PASSWORD=Admin1234!

# ===========================================
# RATE LIMITING
# ===========================================
# Intentos máximos de login por IP
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15